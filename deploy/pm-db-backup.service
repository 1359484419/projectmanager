# systemd oneshot —— 部署到 /etc/systemd/system/pm-db-backup.service，由 pm-db-backup.timer 触发
# 以 postgres 用户走本地 peer 认证执行 pg_dump，不需要 /opt/pm/env 里的密码
[Unit]
Description=projectmanager daily PostgreSQL backup (pg_dump -Fc pm)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/opt/pm/db-backup.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
